# ---------------------------------------------------------------------------
# Classroom Photo Attendance - environment template.
# Copy to `.env` (root) or `backend/.env` and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Production (docker compose sets this automatically):
# DATABASE_URL=postgresql+psycopg://attendance:CHANGE_ME@postgres:5432/attendance
# Lightweight local dev (SQLite):
DATABASE_URL=sqlite:///./data/app.db

# Postgres credentials used by docker-compose.yml (dev defaults only)
POSTGRES_DB=attendance
POSTGRES_USER=attendance
POSTGRES_PASSWORD=change-me-in-production

# --- Auth -------------------------------------------------------------------
# REQUIRED in production: long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Storage ----------------------------------------------------------------
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=10485760

# --- Face recognition (Milestone 3) -----------------------------------------
# Cosine-similarity threshold for MATCHED vs UNCERTAIN vs UNKNOWN.
# Tune on a validation set; 0.70 is a starting point, not a universal truth.
FACE_MATCH_THRESHOLD=0.70
FACE_UNCERTAIN_THRESHOLD=0.55
# Swappable implementations live in backend/app/recognition/
FACE_DETECTOR=opencv_yunet
FACE_EMBEDDER=opencv_sface

# --- Retention ---------------------------------------------------------------
# Classroom image retention: keep | 7 | 30 | 90 | delete_after_finalize
IMAGE_RETENTION_DAYS=90

# --- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- Flutter web build -------------------------------------------------------
# Baked into the web build via --dart-define; the Android app configures the
# server URL in Settings instead.
API_BASE_URL=http://localhost:8000
