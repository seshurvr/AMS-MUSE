# Copy to .env and fill in real values. Never commit a real .env.
# Root .env.example documents the full compose-level configuration.

# Production: postgresql+psycopg://user:password@postgres:5432/attendance
DATABASE_URL=sqlite:///./data/app.db
# Generate a random secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# (JWT_SECRET is also accepted as an alias for docker-based setups.)
SECRET_KEY=change-me-generate-a-random-secret
# (UPLOAD_DIR is also accepted as an alias.)
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE=10485760
DETECTION_CONFIDENCE_THRESHOLD=0.5
IMAGE_RETENTION_DAYS=90
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:8080

# --- Face recognition (Milestone 3) -----------------------------------------
# Cosine-similarity threshold for MATCHED vs UNCERTAIN vs UNKNOWN.
# Tune on a validation set; 0.70 is a starting point, not a universal truth.
FACE_MATCH_THRESHOLD=0.70
FACE_UNCERTAIN_THRESHOLD=0.55
FACE_DETECTOR=opencv_yunet
FACE_EMBEDDER=opencv_sface

# --- Auth rate limiting (slowapi "N/minute" strings) -------------------------
RATE_LIMIT_LOGIN=10/minute
